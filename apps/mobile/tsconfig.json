{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "ES2023"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app",
    "components",
    "lib",
    "*.ts",
    "*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "ios",
    "android"
  ]
}
