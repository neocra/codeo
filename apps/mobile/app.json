{
  "expo": {
    "name": "Codeo Remote",
    "slug": "codeo-remote",
    "version": "0.1.0",
    "scheme": "codeo",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0e0d",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.codeo.remote",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.codeo.remote",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "approvals"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Codeo Remote asks for Face ID before sending an approval decision to your computer."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Codeo Remote uses the camera to scan the pairing QR code shown by Codeo on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
