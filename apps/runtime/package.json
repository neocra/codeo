{
  "name": "@codeo/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "codeo-runtime": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=200"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@openai/codex-sdk": "^0.162.1",
    "@codeo/agent-provider-claude-code": "workspace:*",
    "@codeo/agent-provider-codex": "workspace:*",
    "@codeo/agent-provider-core": "workspace:*",
    "@codeo/contracts": "workspace:*",
    "@codeo/database": "workspace:*",
    "@codeo/domain": "workspace:*",
    "@codeo/git": "workspace:*",
    "@codeo/shared-utils": "workspace:*",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0",
    "@codeo/remote-client": "workspace:*"
  }
}
