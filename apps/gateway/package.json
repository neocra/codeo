{
  "name": "@codeo/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Codeo remote gateway: pairs mobile devices with runtimes and relays the runtime protocol. Never executes development work.",
  "main": "./src/app.ts",
  "types": "./src/app.ts",
  "bin": {
    "codeo-gateway": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=200"
  },
  "dependencies": {
    "@codeo/contracts": "workspace:*",
    "@codeo/shared-utils": "workspace:*",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.4.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
