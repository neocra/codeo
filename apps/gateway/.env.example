# Codeo gateway — see docs/security/remote-access.md
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# Public URL embedded in pairing QR codes (what mobile devices will connect to).
PUBLIC_URL=https://gateway.example.com
# HMAC-SHA256 key for access tokens (>= 32 chars). Required in production; auto-generated in dev.
GATEWAY_SECRET=
# Optional: terminate TLS in-process. Prefer a reverse proxy in production.
TLS_CERT=
TLS_KEY=
# Set to true only behind a trusted reverse proxy (X-Forwarded-For is then used for rate limiting).
TRUST_PROXY=false
# PostgreSQL store (required in production). Unset in development: in-memory, lost on restart.
DATABASE_URL=
DATABASE_POOL_SIZE=10
AUDIT_RETENTION_DAYS=90
PAIRING_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info
# Push notifications for pending approvals (content-free: ids only). A provider without credentials is
# reported as not configured to the phone, never faked.
# APNs token auth: the .p8 key, its 10-character key id and the team id (all three or none).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.codeo.remote
# FCM HTTP v1: a Google service-account JSON key of the Firebase project the Android app is registered in.
FCM_SERVICE_ACCOUNT_PATH=
