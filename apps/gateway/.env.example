# Codeo gateway — see docs/security/remote-access.md
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
# Public URL embedded in pairing QR codes (what mobile devices will connect to).
PUBLIC_URL=https://gateway.example.com
# HMAC-SHA256 key for access tokens (>= 32 chars). Required in production; auto-generated in dev.
GATEWAY_SECRET=
# Optional: terminate TLS in-process. Prefer a reverse proxy in production.
TLS_CERT=
TLS_KEY=
# Set to true only behind a trusted reverse proxy (X-Forwarded-For is then used for rate limiting).
TRUST_PROXY=false
PAIRING_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info
